# Fine riga LF nel repository, chiunque faccia il commit (Windows compreso):
# gli script e i file di configurazione con CRLF fanno brutti scherzi su Linux.
* text=auto eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

# Binari: mai toccati
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.gif   binary
