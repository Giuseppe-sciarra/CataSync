# ════════════════════════════════════════════════════════════════════════════
#  Configurazione — copia questo file in .env e compila i valori.
#  Il .env non va MAI nel repository. Qui c'è solo la parte tecnica: nome,
#  logo, favicon, motori di ricerca e traduzione si impostano dal pannello
#  (Impostazioni).
# ════════════════════════════════════════════════════════════════════════════

# ─── Sicurezza (obbligatorio) ───────────────────────────────────────────────
# Firma i cookie di sessione:   openssl rand -hex 32
SECRET_KEY=
# Cifra a riposo le chiavi REST dei siti e quelle dei motori di ricerca.
# Conservala anche fuori dal server: persa questa, le chiavi vanno reinserite.
#   openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=
# Password del database (lettere e numeri: niente @ : / che rompono l'URL)
POSTGRES_PASSWORD=
# Chiave di SearXNG:            openssl rand -hex 32
SEARXNG_SECRET=

# ─── Primo avvio ────────────────────────────────────────────────────────────
# Crea l'amministratore. Dopo il primo accesso svuota ADMIN_PASSWORD e rideploya:
# l'utente ormai esiste, la password si cambia dal pannello.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── Rete ───────────────────────────────────────────────────────────────────
# Indirizzo pubblico del portale, es. https://catalogo.example.com: serve al
# controllo di provenienza delle richieste che scrivono. Deve essere quello che
# si apre nel browser, altrimenti i salvataggi danno «Richiesta con provenienza
# non valida». Vuoto = si usa l'host della richiesta. Serve anche per caricare
# le foto dal computer nel Magazzino: il sito le scarica da questo indirizzo.
PUBLIC_URL=
# Il portale ascolta su BIND_ADDRESS:HOST_PORT. Di serie solo in locale: se il
# reverse proxy (NPMplus, Traefik, Caddy…) sta su un'altra macchina metti
# 0.0.0.0 e limita la porta all'indirizzo del proxy col firewall.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8811
# 0 solo se lo esponi in HTTP puro (prove in locale)
COOKIE_SECURE=1
TZ=Europe/Rome

# ─── Posta: codici della verifica in due passaggi via email ──────────────────
# Il server SMTP con cui il portale spedisce i codici. Vuoto = la verifica via
# email non è disponibile (restano passkey e app di autenticazione).
# SMTP_SECURITY: starttls (porta 587, di serie), ssl (porta 465) oppure none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Mittente delle email, es. «Portale <noreply@example.com>». Vuoto = SMTP_USER.
SMTP_FROM=

# ─── Ricerca delle schede ───────────────────────────────────────────────────
# Lingua delle schede quando nessuno la sceglie: IT, EN, FR, DE, ES.
# Il cliente e il singolo negozio possono averne una loro (Clienti / Siti).
DEFAULT_LANG=IT
# Archivio delle schede già trovate (per codice e lingua, solo testi e link alle foto):
# 0 = restano per sempre e un codice già cercato non si ricerca più; N = si ricercano dopo N giorni
CACHE_DAYS=0
# Secondi fra una ricerca e l'altra sui motori gratuiti: è ciò che evita i CAPTCHA
SEARCH_PAUSE=4
# Quante volte rimandare un codice quando i motori ci bloccano, prima di arrendersi
SEARCH_MAX_DEFERRALS=4

# ─── Coda e siti ────────────────────────────────────────────────────────────
# Righe lavorate insieme dalla coda
WORKER_BATCH=5
# Secondi di attesa per le risposte dei siti WooCommerce
SITE_TIMEOUT=60
# Pagine massime da sfogliare sul catalogo del sito (100 prodotti a pagina)
WC_MAX_SCAN_PAGES=30

# ─── Codice sorgente ────────────────────────────────────────────────────────
# Link «Codice sorgente» in fondo alle pagine. AGPL-3.0: se modifichi il
# programma e lo offri in rete ad altri, deve puntare al TUO sorgente.
SOURCE_URL=https://github.com/Giuseppe-sciarra/CataSync

# ─── Solo senza il compose di serie ─────────────────────────────────────────
# Col docker-compose.yml l'URL del database lo costruisce il compose. Serve
# solo per un Postgres esterno o per SQLite; postgresql:// va bene così.
# DATABASE_URL=postgresql://hub:password@db:5432/hub
# DATABASE_URL=sqlite:////data/hub.db

# ─── Aggiornamento automatico notturno (aggiorna-tutto.sh) ──────────────────
# Chi riceve l'email di riepilogo (arriva solo se qualcosa si aggiorna o fallisce).
AGG_MAIL_A=tuo@indirizzo.it
